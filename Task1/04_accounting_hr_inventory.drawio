        <mxCell id="9-p-8iqoFNUnEbs2YFMY-2" value="&lt;br&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;b&gt;Меры защиты&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;C4. Защищённые каналы&lt;br style=&quot;border-color: rgb(218, 220, 224);&quot;&gt;&lt;span style=&quot;&quot;&gt;(TLS, VPN)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;C5. Шифрование баз 1С,&lt;br style=&quot;border-color: rgb(218, 220, 224);&quot;&gt;&lt;span style=&quot;&quot;&gt;сканов и резервных копий&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;C6. RBAC/ABAC и разделение&lt;br style=&quot;border-color: rgb(218, 220, 224);&quot;&gt;&lt;span style=&quot;&quot;&gt;обязанностей бухгалтера&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;C7. MFA и привилегированный&lt;br style=&quot;border-color: rgb(218, 220, 224);&quot;&gt;&lt;span style=&quot;&quot;&gt;доступ к 1С и серверу&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;C8. Аудит изменений,&lt;br style=&quot;border-color: rgb(218, 220, 224);&quot;&gt;&lt;span style=&quot;&quot;&gt;экспорта и закрытия периода&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;C9. DLP: защищённая отправка&lt;br style=&quot;border-color: rgb(218, 220, 224);&quot;&gt;&lt;span style=&quot;&quot;&gt;отчётности и запрет копий&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;C10. Маскирование зарплаты&lt;br style=&quot;border-color: rgb(218, 220, 224);&quot;&gt;&lt;span style=&quot;&quot;&gt;и реквизитов в отчётах&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;C12. Сроки хранения&lt;br style=&quot;border-color: rgb(218, 220, 224);&quot;&gt;&lt;span style=&quot;&quot;&gt;и удаление данных&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;C17. Оценка поставщиков&lt;br style=&quot;border-color: rgb(218, 220, 224);&quot;&gt;&lt;span style=&quot;&quot;&gt;и договорные обязательства&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d6a4f;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
